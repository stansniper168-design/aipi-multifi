+#if CONFIG_MUSE_TTS_GROQ
+// Groq text-to-speech voice: >voice={"url":...,"model":...,"voice":...,"key":...}
+// saves the voice; >voice= with no body (or {}) prints the status. The key is
+// never printed: the status only says whether one is set. (The line buffer is
+// wiped by feed() after the command runs, as with the SDK token.)
+static bool voice_command(const char *line) {
+    const char *prefix = "voice=";
+    if (strncmp(line, prefix, strlen(prefix))) return false;
+    char url[MUSE_TTS_URL_MAX + 1], model[MUSE_TTS_MODEL_MAX + 1];
+    char voice[MUSE_TTS_VOICE_MAX + 1], key[MUSE_TTS_KEY_MAX + 1];
+    int rc = muse_tts_groq_parse_voice_cmd(line + strlen(prefix), url, sizeof(url), model, sizeof(model),
+                                           voice, sizeof(voice), key, sizeof(key));
+    const char *result = "error invalid";
+    if (rc == 0) {
+        muse_settings_set_tts(url, model, voice, key);
+        result = "saved";
+    } else if (rc == 1) {
+        muse_settings_tts(url, model, voice, key);
+        // Status deliberately excludes the key itself.
+        cJSON *status = cJSON_CreateObject();
+        bool built = status && cJSON_AddStringToObject(status, "url", url) &&
+                     cJSON_AddStringToObject(status, "model", model) &&
+                     cJSON_AddStringToObject(status, "voice", voice) &&
+                     cJSON_AddBoolToObject(status, "key_set", key[0] != 0) &&
+                     cJSON_AddBoolToObject(status, "configured", muse_settings_tts_configured());
+        char *text = built ? cJSON_PrintUnformatted(status) : NULL;
+        if (text) printf("@voice %s\n", text);
+        else printf("@voice error memory\n");
+        cJSON_free(text);
+        cJSON_Delete(status);
+        result = NULL;
+    }
+    network_proxy_wipe(key, sizeof(key));
+    if (result) printf("@voice %s\n", result);
+    fflush(stdout);
+    return true;
+}
+#endif
