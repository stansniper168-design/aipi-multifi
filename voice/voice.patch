+            return; /* nothing spoken: start_tts() falls back to silent text */
+        }
+        m.pcm_end = s_turn.pcm_out;
+        m.pcm_frames = s_turn.pcm_out - m.pcm_start;
+        m.tts = TTS_FINISHED;
+        s_turn.tts_msg = -1;
+    }
+}
