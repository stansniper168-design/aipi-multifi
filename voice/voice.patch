 /* Decodes buffered MP3 while the reply buffer has room. */
+#if CONFIG_MUSE_TTS_GROQ
+/* Plays fetched WAV PCM (Groq/Orpheus) from the fetch task's stream buffer:
+ * mono-convert, resample to the speaker's 16 kHz, push to s_out. The resampler
+ * needs out to hold n*out/in + 2, so each batch is capped by both the
+ * resampled output buffer and the speaker room left. */
+static void decode_wav(void)
+{
+    if (!s_tts_wav_header_seen.load() || !s_tts_pcm) {
+        return;
+    }
+    uint32_t rate = s_tts_wav_rate.load();
+    uint16_t channels = s_tts_wav_channels.load();
+    uint16_t bits = s_tts_wav_bits.load();
+    size_t frame_bytes = (size_t)channels * (bits / 8);
+    if (!rate || !frame_bytes) {
+        return;
+    }
+    uint8_t raw[2048]; /* one conversion batch of raw PCM */
+    while (xStreamBufferSpacesAvailable(s_out) >= 64 * sizeof(int16_t)) {
+        size_t avail = xStreamBufferBytesAvailable(s_tts_pcm);
+        if (avail < frame_bytes) {
+            break;
+        }
+        size_t take = avail / frame_bytes;
+        size_t room = xStreamBufferSpacesAvailable(s_out) / sizeof(int16_t);
+        size_t max_out = room < (size_t)(MINIMP3_MAX_SAMPLES_PER_FRAME + 8)
+                             ? room
+                             : (size_t)(MINIMP3_MAX_SAMPLES_PER_FRAME + 8);
+        if (max_out > 2) {
+            size_t by_out = (max_out - 2) * rate / MIC_RATE;
+            if (take > by_out) {
+                take = by_out;
+            }
+        } else {
+            take = 0;
+        }
+        if (take > (size_t)MINIMP3_MAX_SAMPLES_PER_FRAME) {
+            take = MINIMP3_MAX_SAMPLES_PER_FRAME;
+        }
+        size_t bytes = take * frame_bytes;
+        if (bytes > sizeof(raw)) {
+            take = sizeof(raw) / frame_bytes;
+            bytes = take * frame_bytes;
+        }
+        if (!take) {
+            break;
+        }
+        size_t got = xStreamBufferReceive(s_tts_pcm, raw, bytes, 0);
+        size_t frames = got / frame_bytes;
+        if (!frames) {
+            break;
+        }
+        if (bits == 16) {
+            const int16_t *in = (const int16_t *)raw;
+            if (channels == 2) {
+                for (size_t k = 0; k < frames; k++) {
+                    s_pcm[k] = (int16_t)((in[2 * k] + in[2 * k + 1]) / 2);
+                }
+            } else {
+                memcpy(s_pcm, in, frames * sizeof(int16_t));
+            }
+        } else { /* 8-bit unsigned */
+            if (channels == 2) {
+                for (size_t k = 0; k < frames; k++) {
+                    s_pcm[k] = (int16_t)(((int16_t)(raw[2 * k] - 128) + (int16_t)(raw[2 * k + 1] - 128)) * 128);
+                }
+            } else {
+                for (size_t k = 0; k < frames; k++) {
+                    s_pcm[k] = (int16_t)(((int16_t)raw[k] - 128) * 256);
+                }
+            }
+        }
+        if (s_turn.down_rate != (int)rate) {
+            ESP_LOGI(TAG, "reply audio: %u Hz, %u ch, WAV", rate, channels);
+            s_turn.down_rate = (int)rate;
+            resampler_init(&s_turn.down, (int)rate, MIC_RATE);
+        }
+        size_t n = resample(&s_turn.down, s_pcm, frames, s_pcm16);
+        if (s_turn.gen == s_gen.load()) {
+            mark(M_AUDIO);
+            xStreamBufferSend(s_out, s_pcm16, n * sizeof(int16_t), 0);
+        }
+        s_turn.pcm_out += n;
+    }
+    if (s_tts_ended.load() && !xStreamBufferBytesAvailable(s_tts_pcm)) {
+        msg_t &m = s_turn.msgs[s_turn.tts_msg];
